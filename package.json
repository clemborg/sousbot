{
  "name": "sousbot",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @sousbot/shared && npm run dev -w @sousbot/web",
    "build": "npm run build -w @sousbot/shared && npm run build -w @sousbot/web",
    "typecheck": "npm run build -w @sousbot/shared && npm run typecheck -w @sousbot/web",
    "db:generate": "npm run db:generate -w @sousbot/web",
    "import:recipes": "tsx automation/ingestion/import-recipes.ts",
    "import:recipes:apply": "tsx automation/ingestion/import-recipes.ts --apply",
    "import:recipes:publish": "tsx automation/ingestion/import-recipes.ts --apply --publish",
    "db:seed": "tsx automation/ingestion/import-recipes.ts --dir recipes/fixtures --apply --publish"
  },
  "devDependencies": {
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.5",
    "pg": "^8.16.3",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "zod": "^4.1.0"
  }
}
