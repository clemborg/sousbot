SUPABASE_URL=https://kkdswyfeznxrntungivm.supabase.co
# The publishable key from Supabase project settings (not a database admin credential)
SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
# DATABASE_URL is the Postgres connection string from Supabase's Connect dialog.
# Keep it local / in hosting secrets; never commit it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
PORT=4000
WEB_ORIGIN=http://localhost:5173

# For deployment on Vercel, use Supabase Connect > Transaction pooler (port 6543)
# with SSL. Never put this URL/password into a VITE_* env var.
# A direct/session connection is appropriate for schema migrations instead.
